generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
// MVP: single implicit user. Add real auth (NextAuth) once the core flow works.

// A named group of documents (e.g. a subject, a course, an exam) - purely
// organizational, optional. Deleting a collection does NOT delete its
// documents, just ungroups them (see onDelete: SetNull below).
model Collection {
  id        String     @id @default(cuid())
  name      String
  createdAt DateTime   @default(now())
  documents Document[]
}

model Document {
  id        String    @id @default(cuid())
  title     String
  createdAt DateTime  @default(now())
  chunks    Chunk[]
  flashcards Flashcard[]

  collectionId String?
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  @@index([collectionId])
}

// A chunk of a document's text, plus its embedding vector for RAG retrieval.
// Stored as a plain float array so no pgvector extension is required to get started.
model Chunk {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content    String
  embedding  Float[]
  chunkIndex Int
  createdAt  DateTime @default(now())

  @@index([documentId])
}

model Flashcard {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  question   String
  answer     String

  // Simplified SM-2 spaced repetition state
  repetition   Int      @default(0)
  easeFactor   Float    @default(2.5)
  intervalDays Int      @default(0)
  dueAt        DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([documentId])
  @@index([dueAt])
}
